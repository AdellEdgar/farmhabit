{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal. Añadir solo lo imprescindible.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-stat",
    "fs:allow-read-text-file",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://oauth2.googleapis.com/*" },
        { "url": "https://www.googleapis.com/*" },
        { "url": "https://*/*" }
      ]
    }
  ]
}
